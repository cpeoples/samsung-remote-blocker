# Copy to .env next to docker-compose.yml. Only TV_IP is required.

TV_IP=192.168.0.110

# Registry slugs (see samsung_remote_blocker/apps.json) or raw id:Name pairs.
BLOCKED_APPS=netflix,disney,prime,hulu,youtube
ALLOWED_APPS=plex,jellyfin

# Plex auto-resume. The token comes from `plex-login` unless PLEX_TOKEN,
# PLEX_TOKEN_FILE or PLEX_PREFERENCES is set.
PLEX_URL=

# Jellyfin auto-resume. Create the key under Dashboard > API Keys.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Defaults: POLL_SECONDS=0.25 PLEX_POLL_SECONDS=1 RESUME_WINDOW=3 RESUME_DELAY=2
